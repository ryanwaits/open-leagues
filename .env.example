DATABASE_URL=
PGLITE_DATA_DIR=
PGLITE_EPHEMERAL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CRON_SECRET=
# Docker / long-lived host only. Set to 1 for in-process league tick.
# Do NOT set on Vercel (vercel.json cron is the clock there).
OPENLEAGUES_SELF_TICK=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_AUTH_ISSUER=
VITE_AUTH_ENABLED=
# Who /api/mcp trusts. "token" (default) = ol_ bearer minted at /account or with
# `bun scripts/ledger.mjs mintToken --write`. "proxy" = your edge already
# authenticated the caller and passes their user id on a header.
OPENLEAGUES_MCP_AUTH=
# proxy mode only. Header carrying the user id (default x-openleagues-user).
OPENLEAGUES_MCP_USER_HEADER=
# proxy mode only. Shared value your proxy sends as x-openleagues-proxy-secret,
# proving the request came through it. Unset = the box warns and trusts the
# header, so only do that when nothing else can reach the origin.
OPENLEAGUES_MCP_PROXY_SECRET=
# Agent host tokens (ol_…) are minted in-app or by the CLI — never put them here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web Push (generate with `web-push generate-vapid-keys`; never commit real keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Public betting splits for the lab (ticket % / money %). Off by default. A
# comma-separated list of sources:
#   actionnetwork — consensus, the only one with history (2023 season on)
#   dknetwork     — DraftKings' own handle and bet share, current slate only
#   wiseguyteam   — multi-book aggregate with the book named, current slate only
# All three are undocumented web endpoints, so opting in is yours. Every pulled
# week is kept on this box.
OPENLEAGUES_SPLITS_SOURCE=

# What kind of box this is. Unset = "substrate": receipts, open data, the lab,
# and /api/mcp for anyone, with no accounts, tokens, or leagues — the public
# host's shape, and the safe default. Set "league" for the whole product:
# accounts, hosted leagues, the desk, tokens. docker-compose and `bun run dev`
# set it for you.
OPENLEAGUES_MODE=
