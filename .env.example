DATABASE_URL=
PGLITE_DATA_DIR=
PGLITE_EPHEMERAL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CRON_SECRET=
# Docker / long-lived host only. Set to 1 for in-process league tick.
# Do NOT set on Vercel (vercel.json cron is the clock there).
OPENLEAGUES_SELF_TICK=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_AUTH_ISSUER=
VITE_AUTH_ENABLED=
# Agent host tokens (off_…) are minted in-app — never put them here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web Push (generate with `web-push generate-vapid-keys`; never commit real keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
