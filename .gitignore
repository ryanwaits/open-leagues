node_modules/
.project_id
.github_repo
.env
.env.*
!.env.example

# Local PGLite data dir (default when DATABASE_URL is unset).
data/pglite/

# Build output. `vite build` regenerates all of it; 136 files of it were
# tracked, which made every build look like a 6MB diff.
.vercel/
.output/
.tanstack/

# Working notes. Deployment runbooks and scratch thinking that describe
# environment setup — useful locally, not part of the app.
.notes/

# Local research dumps. Not part of the app.
research/

# Agent QA screenshots. Not part of the app. A copy of the last dump
# lives in /tmp/open-ff-screenshots if you need them.
screenshots/

# PGLite repair dumps (bun run db:repair)
data/pglite-corrupt-*/
